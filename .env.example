# ==============================================================================
# NGO Management System — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env before running or building the Flutter application.
# For server/Docker deployment, see DEPLOYMENT.md and backend/.env.
# NEVER store database passwords (POSTGRES_PASSWORD) in the Flutter client .env!
# ==============================================================================

# ── Environment Mode ─────────────────────────────────────────────────────────
# Options: development | testing | production
# - development: Local Docker backend (allows localhost/127.0.0.1 HTTP)
# - testing: Remote VPS connectivity testing (allows remote IP HTTP for testing)
# - production: Production release (STRICTLY requires remote HTTPS with TLS)
ENVIRONMENT=development

# ── Firebase Authentication & Realtime Database ──────────────────────────────
# Authoritative Firebase project: ngo-management-system-new-as
FIREBASE_PROJECT_ID=ngo-management-system-new-as
FIREBASE_DATABASE_URL=https://ngo-management-system-new-as-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_API_KEY=your_firebase_web_api_key_here
FIREBASE_AUTH_DOMAIN=ngo-management-system-new-as.firebaseapp.com

# ── PostgreSQL-Backed Fastify Backend API ────────────────────────────────────
# Set USE_POSTGRES_BACKEND=true to route all domain operations through PostgreSQL.
USE_POSTGRES_BACKEND=true

# Development endpoint:  http://127.0.0.1:8808/api
# VPS test endpoint:     http://46.202.167.86:8808/api
# Production endpoint:   https://your-domain.org/api (HTTPS required in production)
BACKEND_API_URL=http://127.0.0.1:8808/api

# ── Optional Payment Backend ──────────────────────────────────────────────────
# Leave blank to disable online payment links.
RAZORPAY_BACKEND_URL=
