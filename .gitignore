# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment and secret files — NEVER commit these
.env
.env.local
*.env.local
.env.*
!.env.example

# Service account credentials — NEVER commit these
**/service-account*.json
**/*service-account*.json

# Private production migration snapshots and rollback journals.
/migration_reports/
/backend/tests/.tmp/
/audit/.tmp/
*.dump
*.backup
*.bak
*.sql.gz
*firebase*export*.json
*rtdb*export*.json
/pgdata/
/ngo-pgdata/
.vite/

# Node.js and TypeScript Backend
node_modules/
**/node_modules/
backend/dist/
backend/build/
*.tsbuildinfo
.npm/

# Python (if any auxiliary tools used)
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/
.pytest_cache/
.coverage
htmlcov/
backend/.venv/
backend/venv/
venv/
