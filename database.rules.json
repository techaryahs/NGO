{
  "rules": {
    "users": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
      "$uid": {
        ".read": "auth != null && $uid == auth.uid",
        ".write": "$uid === auth.uid",
        ".validate": "newData.child('role').val() == (data.exists() ? data.child('role').val() : 'volunteer') && newData.child('uid').val() == $uid"
      }
    },
    "patientPhotos": {
      "$patientId": {
        "patient": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
          ".validate": "$patientId.matches(/^[A-Za-z0-9_-]+$/) && newData.hasChildren(['data', 'contentType', 'version', 'updatedAt']) && newData.child('data').isString() && newData.child('data').val().length <= 409600 && (newData.child('contentType').val() == 'image/jpeg' || newData.child('contentType').val() == 'image/png') && newData.child('version').isNumber() && newData.child('updatedAt').isNumber()"
        },
        "attendants": {
          "$attendantKey": {
            ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
            ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
            ".validate": "$patientId.matches(/^[A-Za-z0-9_-]+$/) && $attendantKey.matches(/^[A-Za-z0-9_-]+$/) && newData.hasChildren(['data', 'contentType', 'version', 'updatedAt']) && newData.child('data').isString() && newData.child('data').val().length <= 409600 && (newData.child('contentType').val() == 'image/jpeg' || newData.child('contentType').val() == 'image/png') && newData.child('version').isNumber() && newData.child('updatedAt').isNumber()"
          }
        }
      }
    },
    "patients": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
      ".indexOn": [
        "status",
        "roomId",
        "floor",
        "searchKey",
        "registrationNumber"
      ],
      "$patientId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff') && (newData.exists() || root.child('users').child(auth.uid).child('role').val() == 'admin')",
        ".validate": "newData.hasChildren(['id', 'fullName', 'searchKey', 'dateOfBirth', 'age', 'gender', 'contactNumber', 'emergencyContact', 'emergencyContactName', 'medicalCondition', 'admissionDate', 'status', 'createdAt', 'updatedAt', 'createdBy']) && newData.child('id').val() == $patientId && (data.exists() ? newData.child('payments').val() == data.child('payments').val() && newData.child('totalPaidAmount').val() == data.child('totalPaidAmount').val() && newData.child('paymentStatus').val() == data.child('paymentStatus').val() && newData.child('currentDueAmount').val() == data.child('currentDueAmount').val() && newData.child('admissionBalances').val() == data.child('admissionBalances').val() && newData.child('paymentPending').val() == data.child('paymentPending').val() && newData.child('refundDueAmount').val() == data.child('refundDueAmount').val() && newData.child('totalRefundDueAmount').val() == data.child('totalRefundDueAmount').val() && newData.child('totalRefundedAmount').val() == data.child('totalRefundedAmount').val() : !newData.child('payments').exists() && newData.child('totalPaidAmount').val() == 0 && newData.child('paymentStatus').val() == 'Unpaid' && newData.child('refundDueAmount').val() == 0 && newData.child('totalRefundDueAmount').val() == 0 && newData.child('totalRefundedAmount').val() == 0 && !newData.child('admissionBalances').exists())",
        "photoDataUrl": {
          ".validate": "data.exists() && newData.val() == data.val()"
        },
        "photoRef": {
          ".validate": "newData.isString() && newData.val() == 'patientPhotos/' + $patientId + '/patient'"
        },
        "attendants": {
          "$index": {
            "photoDataUrl": {
              ".validate": "data.exists() && newData.val() == data.val()"
            },
            "photoRef": {
              ".validate": "newData.isString() && newData.val().beginsWith('patientPhotos/' + $patientId + '/attendants/')"
            }
          }
        }
      }
    },
    "rooms": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
      ".write": "root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff'",
      ".indexOn": [
        "roomType",
        "floor",
        "status"
      ],
      "$roomId": {
        ".validate": "newData.hasChildren(['id', 'roomNumber', 'floor', 'roomType', 'status', 'createdAt', 'updatedAt']) && (newData.child('beds').val() == data.child('beds').val() || newData.child('version').val() == (data.child('version').val() == null ? 1 : data.child('version').val() + 1))",
        "version": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "stays": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
      ".write": "root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff'",
      ".indexOn": [
        "patientId",
        "roomId",
        "status",
        "expiryDate",
        "roomNumber"
      ],
      "$stayId": {
        ".validate": "newData.hasChildren(['id', 'patientId', 'roomId', 'admissionDate', 'durationDays', 'expiryDate', 'status', 'createdAt', 'updatedAt'])",
        "patientSnapshot": {
          "photoDataUrl": {
            ".validate": "data.exists() && newData.val() == data.val()"
          },
          "attendants": {
            "$index": {
              "photoDataUrl": {
                ".validate": "data.exists() && newData.val() == data.val()"
              }
            }
          }
        }
      }
    },
    "admin_settings": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
      ".write": "root.child('users').child(auth.uid).child('role').val() == 'admin'"
    },
    "attendance": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
      ".write": "root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff'"
    },
    "attendant_attendance": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
      ".write": "root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff'"
    },
    "payments": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
      ".write": false,
      ".indexOn": [
        "patientId"
      ],
      "$paymentId": {
        ".validate": "newData.hasChildren(['id', 'patientId', 'type', 'amount', 'method', 'date'])",
        "amount": {
          ".validate": "newData.isNumber() && newData.val() != 0"
        },
        "type": {
          ".validate": "newData.val() == 'payment' || newData.val() == 'refund'"
        },
        "source": {
          ".validate": "newData.val() == 'razorpay' || newData.val() == 'manual'"
        }
      }
    },
    "paymentHistory": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
      ".write": false,
      ".indexOn": [
        "patientId"
      ],
      "$paymentId": {
        ".validate": "newData.hasChildren(['id', 'patientId', 'type', 'amount', 'method', 'date'])",
        "amount": {
          ".validate": "newData.isNumber() && newData.val() != 0"
        }
      }
    },
    "paymentLinks": {
      ".read": false,
      ".write": false
    },
    "razorpayEvents": {
      ".read": false,
      ".write": false
    },
    "payment_details": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
      ".write": "root.child('users').child(auth.uid).child('role').val() == 'admin'"
    },
    "metadata": {
      ".read": "auth != null",
      "stats": {
        ".write": "root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff'"
      }
    },
    "inventory_items": {
      ".read": "auth != null",
      ".write": "root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff'"
    },
    "vendors": {
      ".read": "auth != null",
      ".write": "root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff'"
    },
    "purchases": {
      ".read": "auth != null",
      ".write": "root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff'"
    },
    "expense_entries": {
      ".read": "auth != null",
      ".write": "root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff'"
    },
    "salaries": {
      ".read": "auth != null",
      ".write": "root.child('users').child(auth.uid).child('role').val() == 'admin'"
    },
    "sponsorships": {
      ".read": "auth != null",
      ".write": "root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff'"
    },
    "billingQueue": {
      ".read": false,
      ".write": false
    }
  }
}
