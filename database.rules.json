{
  "rules": {
    "users": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",
        ".write": "auth != null && ($uid === auth.uid || root.child('users').child(auth.uid).child('role').val() == 'admin')",
        ".validate": "newData.child('uid').val() == $uid && (data.exists() ? (newData.child('role').val() == data.child('role').val() || root.child('users').child(auth.uid).child('role').val() == 'admin') : newData.child('role').val() == 'volunteer')"
      }
    },
    "patientPhotos": {
      "$patientId": {
        "patient": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
          ".validate": "$patientId.matches(/^[A-Za-z0-9_-]+$/) && newData.hasChildren(['data', 'contentType', 'version', 'updatedAt']) && newData.child('data').isString() && newData.child('data').val().length <= 409600 && (newData.child('contentType').val() == 'image/jpeg' || newData.child('contentType').val() == 'image/png') && newData.child('version').isNumber() && newData.child('updatedAt').isNumber()"
        },
        "attendants": {
          "$attendantKey": {
            ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
            ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
            ".validate": "$patientId.matches(/^[A-Za-z0-9_-]+$/) && $attendantKey.matches(/^[A-Za-z0-9_-]+$/) && newData.hasChildren(['data', 'contentType', 'version', 'updatedAt']) && newData.child('data').isString() && newData.child('data').val().length <= 409600 && (newData.child('contentType').val() == 'image/jpeg' || newData.child('contentType').val() == 'image/png') && newData.child('version').isNumber() && newData.child('updatedAt').isNumber()"
          }
        }
      }
    },
    "patients": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
      ".indexOn": [
        "status",
        "roomId",
        "floor",
        "searchKey",
        "registrationNumber"
      ],
      "$patientId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff') && (newData.exists() || root.child('users').child(auth.uid).child('role').val() == 'admin')",
        ".validate": "newData.hasChildren(['id', 'fullName', 'searchKey', 'dateOfBirth', 'gender', 'contactNumber', 'emergencyContact', 'emergencyContactName', 'medicalCondition', 'admissionDate', 'status', 'createdAt', 'updatedAt', 'createdBy']) && newData.child('id').val() == $patientId && (newData.child('totalPaidAmount').val() == null || newData.child('totalPaidAmount').isNumber()) && (newData.child('currentDueAmount').val() == null || newData.child('currentDueAmount').isNumber())",
        "photoDataUrl": {
          ".validate": "!newData.exists() || (data.exists() && newData.val() == data.val())"
        },
        "photoRef": {
          ".validate": "newData.isString() && newData.val() == 'patientPhotos/' + $patientId + '/patient'"
        },
        "attendants": {
          "$index": {
            "photoDataUrl": {
              ".validate": "!newData.exists() || (data.exists() && newData.val() == data.val())"
            },
            "photoRef": {
              ".validate": "newData.isString() && newData.val().beginsWith('patientPhotos/' + $patientId + '/attendants/')"
            }
          }
        }
      }
    },
    "rooms": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
      ".indexOn": [
        "roomType",
        "floor",
        "status"
      ],
      "$roomId": {
        ".validate": "newData.hasChildren(['id', 'roomNumber', 'floor', 'roomType', 'status', 'createdAt', 'updatedAt'])",
        "version": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "stays": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
      ".indexOn": [
        "patientId",
        "roomId",
        "status",
        "expiryDate",
        "roomNumber",
        "expectedDischargeDate"
      ],
      "$stayId": {
        ".validate": "newData.hasChildren(['id', 'patientId', 'roomId', 'admissionDate', 'durationDays', 'expiryDate', 'status', 'createdAt', 'updatedAt']) && newData.child('id').val() == $stayId",
        "patientSnapshot": {
          "photoDataUrl": {
            ".validate": "!newData.exists() || (data.exists() && newData.val() == data.val())"
          },
          "attendants": {
            "$index": {
              "photoDataUrl": {
                ".validate": "!newData.exists() || (data.exists() && newData.val() == data.val())"
              }
            }
          }
        }
      }
    },
    "admin_settings": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
    },
    "settings": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
    },
    "attendance": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')"
    },
    "attendant_attendance": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')"
    },
    "payments": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
      ".indexOn": [
        "patientId"
      ],
      "$paymentId": {
        ".validate": "newData.hasChildren(['id', 'patientId', 'type', 'amount', 'method', 'date']) && newData.child('id').val() == $paymentId",
        "amount": {
          ".validate": "newData.isNumber() && newData.val() != 0"
        },
        "type": {
          ".validate": "newData.val() == 'payment' || newData.val() == 'refund' || newData.val() == 'adjustment'"
        },
        "source": {
          ".validate": "newData.val() == 'razorpay' || newData.val() == 'manual'"
        }
      }
    },
    "paymentHistory": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
      ".indexOn": [
        "patientId"
      ],
      "$paymentId": {
        ".validate": "newData.hasChildren(['id', 'patientId', 'type', 'amount', 'method', 'date']) && newData.child('id').val() == $paymentId",
        "amount": {
          ".validate": "newData.isNumber() && newData.val() != 0"
        },
        "type": {
          ".validate": "newData.val() == 'payment' || newData.val() == 'refund' || newData.val() == 'adjustment'"
        }
      }
    },
    "paymentLinks": {
      ".read": false,
      ".write": false
    },
    "razorpayEvents": {
      ".read": false,
      ".write": false
    },
    "payment_details": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
    },
    "metadata": {
      ".read": "auth != null",
      "stats": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')"
      }
    },
    "inventory_items": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')"
    },
    "vendors": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')"
    },
    "purchases": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')"
    },
    "expense_entries": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')"
    },
    "salaries": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
    },
    "sponsorships": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'staff')"
    },
    "billingQueue": {
      ".read": false,
      ".write": false
    }
  }
}
