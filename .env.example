# ==============================================================================
# NGO Management System — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the Docker Compose stack or local services.
# NEVER commit the actual .env file or production credentials into version control.
# ==============================================================================

# ── Database (PostgreSQL 16) ──────────────────────────────────────────────────
POSTGRES_DB=ngo_db
POSTGRES_USER=ngo_user
POSTGRES_PASSWORD=replace_with_secure_password_in_production
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Backend API (Fastify / Node.js) ──────────────────────────────────────────
PORT=8808
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# Comma-separated list or JSON array of allowed CORS origins
CORS_ORIGINS=["*"]

# ── Security & Authentication ────────────────────────────────────────────────
# Public Firebase Auth project ID; must match the Flutter client's project.
# The repository's .firebaserc currently identifies this project.
FIREBASE_PROJECT_ID=ngo-management-system-new-as
# ID tokens are verified with Google's public certificates. No service account
# or backend JWT signing secret is needed by this API or the Flutter client.

# ── Database Connection Pooling (pg.Pool) ────────────────────────────────────
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# ── Docker Compose Overrides (Optional) ──────────────────────────────────────
# POSTGRES_IMAGE=postgres:16-alpine
# POSTGRES_VOLUME_NAME=ngo-pgdata

# ── Flutter Client Backend Flag (Keep false until explicit cutover) ──────────
USE_POSTGRES_BACKEND=false
BACKEND_API_URL=http://localhost:8808/api

